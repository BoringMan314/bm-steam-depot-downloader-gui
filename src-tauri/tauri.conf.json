{
  "productName": "SteamDepotDownloaderGUI",
  "version": "3.2.1",
  "identifier": "net.oopium.depotdownloader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist-web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Steam Depot 下載器",
        "width": 900,
        "height": 720,
        "resizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Steam Depot 下載器",
    "longDescription": "透過 DepotDownloader 輕鬆下載 Steam 遊戲的舊版本。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["TradChinese"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": ["zh-TW"]
      }
    }
  }
}
